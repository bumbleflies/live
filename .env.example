# Google OAuth (existing bumbleflies-only OAuth client, reused via env vars).
# The org restriction lives in the OAuth client's Google Workspace
# configuration; the app additionally rejects non-@bumbleflies.de addresses.
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
# Local dev callback. Production: https://live.bumbleflies.de/auth/google/callback
# (must be added as an authorized redirect URI on the shared OAuth client).
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# JWT signing secret, freshly generated (generate with: openssl rand -hex 32).
# Not shared with queen or any other app.
JWT_SECRET=change_me_in_production

NODE_ENV=development
PORT=3000
