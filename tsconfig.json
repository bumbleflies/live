{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vitest/globals"]
  },
  "include": ["src/client/**/*", "vite.config.ts", "index.html"],
  "exclude": ["src/client/**/__tests__/**", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
